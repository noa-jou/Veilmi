# ------------------------------------------------------------------------------
# 1. Gradle & Android project build files and cache (Android / Kotlin)
# ------------------------------------------------------------------------------
.gradle/
build/
**/build/
android/.gradle/
android/app/build/
android/app/src/main/assets/

# Local configuration
local.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# Android Studio generated files
captures/
.externalNativeBuild/
.cxx/

# APK / App Bundle
*.apk
*.aab

# Signing files and secret configuration
*.jks
*.keystore
keystore.properties

# Kotlin compiler session cache
.kotlin/
android/.kotlin/


# ------------------------------------------------------------------------------
# 2. Flutter / Dart related files (Flutter Core)
# ------------------------------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
/pubspec.lock


# ------------------------------------------------------------------------------
# 3. iOS & macOS project build files (CocoaPods & Xcode)
# ------------------------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.fltf
ios/Runner.xcworkspace/
ios/Runner.xcodeproj/project.xcworkspace/
ios/Runner.xcodeproj/xcuserdata/

macOS/Pods/
macOS/.symlinks/
macOS/Flutter/ephemeral/


# ------------------------------------------------------------------------------
# 4. Editor and IDE configuration files (VS Code / other tools)
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Secrets, keys, and environment variable files (for example .env used by flutter_dotenv)
*.env
*.env.*


# ------------------------------------------------------------------------------
# 5. Operating system temporary files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log

# ------------------------------------------------------------------------------
# 6. Additional platform-generated files that are commonly not tracked
# ------------------------------------------------------------------------------
linux/flutter/ephemeral/
windows/flutter/ephemeral/
web/.*

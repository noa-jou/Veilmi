# This file tells Flutter where the app's translation files live.
# "arb" stands for Application Resource Bundle, which is the format used
# for localized text in Flutter.

# Folder that contains all the language files.
# Example: app_en.arb, app_zh.arb, etc.
arb-dir: lib/l10n

# This is the main template file.
# It is the English version and acts like the source of all text keys.
# The app uses the same keys in other languages, but the values change.
template-arb-file: app_en.arb

# This is the file Flutter will generate automatically.
# It contains Dart code for accessing translations like AppLocalizations.of(context).hello.
# You usually do not edit this file manually because Flutter creates it for you.
output-localization-file: app_localizations.dart